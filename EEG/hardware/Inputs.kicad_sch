  (text "20 kOhm per input branch / 4.7 nF differential / rail clamps are not a certified patient interface"
    (at 25 270 0)
    (effects
      (font
        (size 1.0 1.0)
      )
      (justify left)
    )
    (uuid "39d6d257-9ff1-5de7-99cd-fde52d4a5197")
  )
  (text "[I0] REF compares all channels; BIAS is a driven output."
    (at 240 24.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "99a6fa29-94e2-5ec3-9565-5eb3f6259539")
  )
  (text "J1 has no circuit-ground electrode. Trace CH1_E to CH1_ADC."
    (at 240 27.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "73648c9c-30c8-538d-8dd7-94dd159cd2f4")
  )
  (text "BIAS current path: R11 + R12 = 998 kOhm; bench validation pending."
    (at 240 31.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "4833c44b-5792-5f14-8d81-33beb19db3e7")
  )
  (text "[I1] R1/R9 limit current toward the clamps; R2/R10 add isolation."
    (at 30 145.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "9337bd1a-1c99-5a0f-8868-8d6aeab709ae")
  )
  (text "D1/D5: low-leakage rail clamps; leakage creates input offset."
    (at 30 148.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "a05e1157-47ec-5668-8099-652c58213480")
  )
  (text "C1 bridges P/N: 40 kOhm differential + 4.7 nF gives about 847 Hz."
    (at 30 152.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "cc8f43a5-fa0c-52c9-a5c0-b9db9b7bb64e")
  )
  (text "This is high-frequency attenuation, not the final EEG bandpass."
    (at 30 155.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "d3af0a3f-04cc-5dda-b711-dc66fdb7e24d")
  )
  (text "[I2] REF_E fans out into four separate protected branches."
    (at 220 145.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "d9167757-fd4c-592c-87b6-710d4084704c")
  )
  (text "Each channel has its own negative input and differential capacitor."
    (at 220 148.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "0e4fbc23-01c4-519f-9b91-57487402d96b")
  )
  (text "A disturbance on the shared reference can affect several channels."
    (at 220 152.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "bfbe4b0b-f663-50fa-974e-334499152263")
  )
  (text "Channels 3/4 repeat this topology. Clamps do not certify safety."
    (at 220 155.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
