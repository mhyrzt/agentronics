  )
  (text "AVDD1 feed"
    (at 275 202 0)
    (effects
      (font
        (size 1.0 1.0)
      )
      (justify left)
    )
    (uuid "a9fd6302-0bde-53f0-b438-cb93890bf20f")
  )
  (text "Digital bypass"
    (at 345 202 0)
    (effects
      (font
        (size 1.0 1.0)
      )
      (justify left)
    )
    (uuid "fb486e75-3855-51a6-b56e-2dc10bd7047f")
  )
  (text "Unused GPIO pull-downs"
    (at 25 253 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left)
    )
    (uuid "db655ca6-9e34-5ead-b9b0-e7fabe68010f")
  )
  (text "[F1] U1 converts four differential channels simultaneously."
    (at 25 36.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "a1c4bdde-731d-5320-92b9-aa7ca1e7e092")
  )
  (text "24-bit format does not imply 24-bit measurement accuracy."
    (at 25 39.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "f39a5edc-3f23-55bd-bbf8-610146b41f61")
  )
  (text "[F2] VCAP capacitors support internal circuits; not spare supplies."
    (at 185 98.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "1a128acd-e800-5e60-909e-426915735478")
  )
  (text "C11/C12 steady the ADC conversion reference, not the REF electrode."
    (at 185 101.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "fe0f5954-106d-561e-8fe2-c4f928625a42")
  )
  (text "Use specified values and short local return paths; C6 is polarized."
    (at 185 105.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "8c438a35-cc44-5e70-a4e2-ef16feb21728")
  )
  (text "[F3] R13 || C5 shapes bias feedback."
    (at 320 168.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "bbcef7e2-8235-51c6-9139-1b8eb6aab615")
  )
  (text "RC scale ~159 Hz; actual loop stability needs testing."
    (at 320 171.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "9cfa5cdf-6270-509d-9d14-5f506b78533f")
  )
  (text "Use internal bias reference; enable after bench checks."
    (at 320 175.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "d399b1d2-e274-5a5f-a2a5-16d6ca607964")
  )
  (text "[F4] Pulls define startup: RESET/START low, CS high."
    (at 235 184.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "81ee97a4-5bfe-5e1f-8ca9-b07eb1beebe2")
  )
  (text "CLKSEL/PWDN high; firmware must configure the ADC."
    (at 235 187.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "4328dd9e-8c08-56be-a1a3-5c6e199525f5")
  )
  (text "[F5] Local bypass supplies transient current. R14 is a removable link, not a filter."
    (at 25 282.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "4ac549b3-9211-5c2e-9e01-cf9d5d0f6a3d")
  )
