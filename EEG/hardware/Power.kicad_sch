  (text "Power flags / ERC declarations"
    (at 25 255 0)
    (effects
      (font
        (size 1.0 1.0)
      )
      (justify left)
    )
    (uuid "e67254a0-714f-5890-862d-ba18c46df565")
  )
  (text "J4 shunt enables power; remove shunt or unplug battery for storage"
    (at 235 55 0)
    (effects
      (font
        (size 1.0 1.0)
      )
      (justify left)
    )
    (uuid "8af1ef39-3e30-54d0-bf59-e50ec553cd18")
  )
  (text "[P1] F1: thermal overcurrent response, not a precise cutoff."
    (at 235 18.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "a7a80ade-9586-5388-98bb-2751b274967e")
  )
  (text "D6/D10 diode OR inputs; battery normally wins when both connected."
    (at 235 21.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "59e7e6ab-42f6-5d4f-bd9d-6be6a155c6bd")
  )
  (text "J4 disconnects BAT_SW; unplug the pack for master isolation."
    (at 235 25.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "68244f5a-31c8-5289-a0ed-d8e05e6d7ab9")
  )
  (text "[P2] U3 + L1 transfer switched energy to 3V3."
    (at 180 115.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "49b3d859-c526-5c05-8825-36224f03d9db")
  )
  (text "C30: bootstrap. C31/C32: output charge."
    (at 180 118.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "1bc38bde-2585-5d69-a519-8c910c17963a")
  )
  (text "FB senses 3V3; measure switching ripple."
    (at 180 122.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "a7099afb-23e6-5052-93fa-28229db68f12")
  )
  (text "[P3] Separate analog LDO avoids another local switch node; it is not galvanic isolation."
    (at 25 162.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "4ecb7bfe-4f6d-5614-b396-207c479aa18b")
  )
  (text "C34 bypasses the LDO noise-related node; C35 supports stability."
    (at 235 242.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "45727569-27d8-5fb6-855c-9babd461a986")
  )
  (text "Check effective capacitance / ESR for the installed LP2985 revision."
    (at 235 245.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "e751b3eb-c4da-5d56-be76-a6b1ad795e35")
  )
  (text "Boost gives analog headroom from USB; LDO loss ~ (9.04-5) V x I."
    (at 235 249.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "03895bbf-e968-5068-8ff5-928ad31f75f4")
  )
  (text "[P4] PWR_FLAG declares a driven rail for ERC; it adds no physical part."
    (at 25 282.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "620c8ba7-bf11-56ca-82c6-c76a8331e0a5")
  )
  (text "The pack needs independent protection. No onboard charger or hardware low-voltage cutoff."
    (at 25 285.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "ffc608db-8038-5f85-b3b6-77aecde3e957")
  )
