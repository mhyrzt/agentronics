  (text "[C1] J5 exposes SPI, DRDY, RESET, START, sense signals and ground."
    (at 25 140.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "14f4bf19-27c0-573f-a4ba-4c19e838bb0f")
  )
  (text "Use short cables and 3.3 V GPIO. No onboard ESP32 or RF circuit."
    (at 25 143.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "fc5cfa55-4d98-55be-bff9-74a83ce6c4a1")
  )
  (text "Suggested S3 GPIO map is in README; verify the actual dev board."
    (at 25 147.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "013cc9d2-232a-5459-934f-412466fbfc70")
  )
  (text "[C2] Wi-Fi target: HTTP UI + WebSocket frames; firmware pending."
    (at 25 180.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "6ed62b7e-e4ad-5f00-9add-2f0cd70c1ccc")
  )
  (text "Read on DRDY; use a bounded buffer so networking cannot block sampling."
    (at 25 183.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "13644730-3bb6-51e3-89e2-00b63dae40f8")
  )
  (text "Program through the external board USB, with electrodes disconnected."
    (at 25 187.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "4bdb39e2-5876-5c3d-b607-ad32703762d3")
  )
  (text "[C3] J5 pin 2 is permanently supplied by the EEG 3.3 V rail."
    (at 25 220.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "8489ebf4-3ada-56af-a37a-702a960abe2d")
  )
  (text "Disconnect the J5 pin 2 power cable before its own USB."
    (at 25 223.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "a29a01b7-3bda-5c53-a4a6-3e102a102515")
  )
  (text "Do not feed a dev-board 5 V pin from this 3.3 V output."
    (at 25 227.0 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "09331ad5-f807-5f9e-bc15-3f9aa1fdb927")
  )
  (text "VIN_SENSE measures BAT_SW; USB_PRESENT identifies USB bench power."
    (at 25 230.5 0)
    (effects
      (font
        (size 1.15 1.15)
      )
      (justify left)
    )
    (uuid "c1444636-54ef-5498-8a58-577726e09f75")
  )
  (text "[C4] R31/R32 ratio: 4.3. Verify ADC calibration and settling."
